{
  "description": "Real-time weather information for any location worldwide, from countries to villages",
  "icon": {
    "image": "brand/icon.png"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Home shows the place search",
      "path": "/",
      "expectSelector": "#search-input"
    },
    {
      "id": "header.theme",
      "name": "Header shows the theme switch, Auto by default",
      "path": "/",
      "expectSelector": "#theme-toggle button[data-theme=\"auto\"][aria-pressed=\"true\"]",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "name": "Shell reserves the alerts banner container",
      "path": "/",
      "expectSelector": "#alert-banner"
    },
    {
      "id": "header.sky",
      "name": "Header shows a sky by the viewer's clock with its caption",
      "path": "/",
      "expectSelector": "main:has(#sky[aria-hidden=\"true\"][style*=\"linear-gradient\"]) #sky-caption[data-phase]",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "name": "Report keeps the alerts banner hidden for a place without a feed (Ubud)",
      "path": "/?place=1622846",
      "expectSelector": "#alert-banner.hidden"
    },
    {
      "id": "weather.report",
      "name": "Weather report loads live data for a saved place (Ubud)",
      "path": "/?place=1622846",
      "expectSelector": "#current[data-state=\"loaded\"] #current-temp",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "id": "weather.localtime",
      "name": "Report shows the place's current local time",
      "path": "/?place=1622846",
      "expectSelector": "#location [data-localtime]",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "name": "Forecast draws the hourly temperature trend chart",
      "path": "/?place=1622846",
      "expectSelector": "#forecast figure svg polyline"
    },
    {
      "name": "Report draws the daylight bar under the current weather (Ubud)",
      "path": "/?place=1622846",
      "expectSelector": "#current #daylight div[role=\"img\"]"
    },
    {
      "id": "forecast.wind",
      "name": "Forecast hours show a wind direction arrow (live hourly wind)",
      "path": "/?place=1622846",
      "expectSelector": "#forecast ol li span[role=\"img\"][aria-label]",
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "name": "Report shows a wind speed unit switch (km/j vs mph)",
      "path": "/?place=1622846",
      "expectSelector": "#speed-toggle button[data-speed=\"mph\"][aria-pressed=\"false\"]",
      "expectText": "mph"
    },
    {
      "id": "favorites.toggle",
      "name": "Weather report shows Save once favorites load (real /api/favorites)",
      "path": "/?place=1622846",
      "expectSelector": "#fav-toggle[aria-pressed=\"false\"]:not([disabled])",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "id": "browse.provinces",
      "name": "Region browser opens a country's provinces (real /api/regions)",
      "path": "/?browse=ID",
      "expectSelector": "#browse-list ul[data-level=\"1\"] button[data-row]",
      "expectText": "Central Java",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "data/regions/**"
      ]
    },
    {
      "id": "browse.districts",
      "name": "Region browser deep link opens a province's kabupaten/kota (real /api/regions)",
      "path": "/?browse=ID.30",
      "expectSelector": "#browse-list ul[data-level=\"2\"] button[data-row]",
      "expectText": "Kabupaten Bandung",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "data/regions/**"
      ]
    },
    {
      "name": "Region browser lists all countries",
      "path": "/?browse",
      "expectSelector": "#browse-list ul[data-level=\"0\"] button[data-row]"
    }
  ],
  "governance": {
    "approvers": "invited",
    "approvals": "default"
  }
}
